# everything below was generated by clap_complete
# this is missing stack/service completions, feel free to open a PR

autoload -U is-at-least

_blent() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'--version[Print version]' \
":: :_blent_commands" \
"*::: :->blent" \
&& ret=0
    case $state in
    (blent)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:blent-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'-d[Show details about services]' \
'--detailed[Show details about services]' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'*::filter -- Operate only on matching services. Format\: "stack\:service":__blent_filter' \
&& ret=0
;;
(up)
_arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'()-a[Operate on all known services]' \
'()--all[Operate on all known services]' \
'-f[Recreate services even if they are up to date]' \
'--force-recreate[Recreate services even if they are up to date]' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'*::filter -- Operate only on matching services. Format\: "stack\:service":__blent_filter' \
&& ret=0
;;
(down)
_arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'()-a[Operate on all known services]' \
'()--all[Operate on all known services]' \
'-r[Remove undefined services]' \
'--remove-orphans[Remove undefined services]' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'*::filter -- Operate only on matching services. Format\: "stack\:service":__blent_filter' \
&& ret=0
;;
(logs)
_arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'-f[Follow log output]' \
'--follow[Follow log output]' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'*::filter -- Operate only on matching services, Format\: "stack\:service":__blent_filter' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--app-path=[Directory in which to look for stacks \[default\: ~/app\]]:PATH:_files' \
'()-a[Operate on all known services]' \
'()--all[Operate on all known services]' \
'-p[Prune dangling images after updating]' \
'--prune-dangling[Prune dangling images after updating]' \
'*-v[Increase logging verbosity]' \
'*--verbose[Increase logging verbosity]' \
'(-v --verbose)*-q[Decrease logging verbosity]' \
'(-v --verbose)*--quiet[Decrease logging verbosity]' \
'--help[Print help]' \
'*::filter -- Operate only on matching services. Format\: "stack\:service":__blent_filter' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_blent_commands] )) ||
_blent_commands() {
    local commands; commands=(
'status:Print a summary of stacks' \
'up:Create and start stacks' \
'down:Stop and remove stacks' \
'logs:View output from services' \
'update:Update stack images' \
    )
    _describe -t commands 'blent commands' commands "$@"
}
(( $+functions[_blent__down_commands] )) ||
_blent__down_commands() {
    local commands; commands=()
    _describe -t commands 'blent down commands' commands "$@"
}
(( $+functions[_blent__logs_commands] )) ||
_blent__logs_commands() {
    local commands; commands=()
    _describe -t commands 'blent logs commands' commands "$@"
}
(( $+functions[_blent__status_commands] )) ||
_blent__status_commands() {
    local commands; commands=()
    _describe -t commands 'blent status commands' commands "$@"
}
(( $+functions[_blent__up_commands] )) ||
_blent__up_commands() {
    local commands; commands=()
    _describe -t commands 'blent up commands' commands "$@"
}
(( $+functions[_blent__update_commands] )) ||
_blent__update_commands() {
    local commands; commands=()
    _describe -t commands 'blent update commands' commands "$@"
}

if [ "$funcstack[1]" = "_blent" ]; then
    _blent "$@"
else
    compdef _blent blent
fi
